# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or MongoDB Atlas free M0 cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/pulsa

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime in seconds (15 min)
JWT_ACCESS_TTL=900
# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,https://my-fitness-app-tau-drab.vercel.app

# Render / most PaaS sit behind one proxy hop (needed for per-IP rate limits)
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true

# Marketing offset added to the real user count on GET /stats/public (0 = real count)
PUBLIC_MEMBER_BASE=12400

# Used only by `npm run seed` — the admin account it creates
SEED_ADMIN_EMAIL=admin@pulsa.example
SEED_ADMIN_PASSWORD=
# Coach login (can read its clients' heart data). Empty = random, printed once.
SEED_COACH_PASSWORD=
# Demo member login. Empty = pulsa-demo-2026 in dev; required for a production seed.
SEED_DEMO_PASSWORD=
